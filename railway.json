{
  "$schema": "https://raw.githubusercontent.com/railwayapp/cli/master/schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "dotnet restore && dotnet publish SIGID.API/SIGID.API.csproj -c Release -o /app/publish"
  },
  "deploy": {
    "startCommand": "cd /app/publish && dotnet SIGID.API.dll",
    "healthcheckPath": "/api",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}